diff --git a/scripts/test-shared-persona.mjs b/scripts/test-shared-persona.mjs
new file mode 100644
index 0000000..f94b2aa
--- /dev/null
+++ b/scripts/test-shared-persona.mjs
@@ -0,0 +1,134 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import yaml from 'js-yaml';
+import { readSharedPersona, sharedPersonaFromPrefix, personalMemoryName, canAccessPersonalMemory, HARDWARE_CHANNEL_INSTRUCTIONS,
+  DAFEIYU_PRESET } from '../src/shared-persona.js';
+import { createProfileMemory } from '../src/long-term-memory.js';
+import { bridgeHarness } from './audit-bridge-harness.mjs';
+
+test('default hardware and QQ persona are the existing QQ identity and personality, not a new character', () => {
+  const persona = readSharedPersona();
+  const prefix = yaml.load(fs.readFileSync(DAFEIYU_PRESET, 'utf8')).find(row => row.id === 'persona').config.prefix;
+  assert.equal(persona.name, '大肥鱼');
+  assert.match(persona.text, /DeepSeek.*鲸鱼/);
+  assert.match(persona.text, /不是客服/);
+  assert.match(persona.text, /保持主体性/);
+  assert(!persona.text.includes('qq_wait_for_messages'));
+  assert(!persona.text.includes('qq_send_message'));
+  for (const part of persona.text.split('\n\n').slice(1)) assert(prefix.includes(part));
+  const qq = readSharedPersona(), hardware = readSharedPersona();
+  assert.equal(qq.text, hardware.text);
+  assert.equal(qq.hash, hardware.hash);
+  assert.equal(qq.source, hardware.source);
+});
+
+test('editing the one source changes both channels and selected role is identical', () => {
+  const prefix = yaml.load(fs.readFileSync(DAFEIYU_PRESET, 'utf8')).find(row => row.id === 'persona').config.prefix;
+  const options = { roleName: '测试卡', roleText: '习惯简短地吐槽，但记得共同身份。' };
+  const original = sharedPersonaFromPrefix(prefix, options);
+  assert.equal(original.hash, sharedPersonaFromPrefix(prefix, options).hash);
+  assert(original.text.includes(options.roleText));
+  const modified = sharedPersonaFromPrefix(prefix.replace('你有自己的喜好', '你保留自己的喜好'), options);
+  assert.notEqual(original.hash, modified.hash);
+  assert.equal(modified.text, sharedPersonaFromPrefix(prefix.replace('你有自己的喜好', '你保留自己的喜好'), options).text);
+  assert.throws(() => sharedPersonaFromPrefix('empty'), /identity/);
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'qq-shared-persona-'));
+  try {
+    const file = path.join(root, 'preset.yml');
+    const write = text => fs.writeFileSync(file, yaml.dump([{ id: 'persona', config: { prefix: text } }]));
+    write(prefix);
+    const before = readSharedPersona(options, file);
+    write(prefix.replace('你有自己的喜好', '你保留自己的喜好'));
+    const qq = readSharedPersona(options, file), hardware = readSharedPersona(options, file);
+    assert.equal(qq.text, hardware.text);
+    assert.equal(qq.hash, hardware.hash);
+    assert.notEqual(before.hash, qq.hash);
+  } finally { fs.rmSync(root, { recursive: true }); }
+});
+
+test('QQ and hardware read/write the same personal memory without group or foreign-user mixing', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'qq-shared-memory-'));
+  try {
+    const memory = createProfileMemory({ file: path.join(root, 'people.md') });
+    const scope = personalMemoryName('private:12345', '12345', '12345');
+    assert.equal(scope, 'QQ:12345');
+    assert.equal(personalMemoryName('private:12345', '12345'), scope);
+    assert.equal(personalMemoryName('private:12345', '12345', 'qq:12345'), scope);
+    memory.write(scope, '喜欢：红茶'); // QQ-side name resolution.
+    assert(memory.format({ names: ['QQ:12345'] }).includes('红茶')); // Hardware reads same file/section.
+    memory.write('QQ:12345', '近况：在准备课程'); // Hardware-side write.
+    assert(memory.format({ names: [scope] }).includes('在准备课程'));
+    memory.write('QQ:99999', '秘密：不得混入');
+    assert(!memory.format({ names: [scope] }).includes('不得混入'));
+    assert.equal(personalMemoryName('group:12345', '12345', '12345'), '12345');
+    assert.equal(personalMemoryName('private:99999', '12345', '99999'), '99999');
+    assert(!canAccessPersonalMemory('group:12345', 'QQ:12345'));
+    assert(!canAccessPersonalMemory('group:12345', 'qq:12345'));
+    assert(!canAccessPersonalMemory('private:99999', 'QQ:12345'));
+    assert(canAccessPersonalMemory('private:12345', 'QQ:12345'));
+    memory.forget(personalMemoryName('private:12345', '12345', '12345'), '喜欢');
+    assert(!memory.format({ names: [scope] }).includes('红茶'));
+  } finally { fs.rmSync(root, { recursive: true }); }
+});
+
+test('hardware preset contains channel rules only and bridge uses the one persona provider on both paths', () => {
+  assert.match(HARDWARE_CHANNEL_INSTRUCTIONS, /不在硬件端另设人格/);
+  assert(!HARDWARE_CHANNEL_INSTRUCTIONS.includes('温柔陪伴'));
+  assert(!HARDWARE_CHANNEL_INSTRUCTIONS.includes('qq_wait_for_messages'));
+  const bridge = fs.readFileSync(new URL('../src/bridge.js', import.meta.url), 'utf8');
+  assert(bridge.includes('getPersona: currentSharedPersona'));
+  assert(bridge.includes('const persona = currentSharedPersona();'));
+  assert(bridge.includes('sharedPersona: currentSharedPersona()'));
+});
+
+test('real QQ prompt delivery and memory HTTP routes use the shared persona and personal store', async () => {
+  const h = await bridgeHarness();
+  h.setMode('reserved2');
+  h.setHardwareChannel({ privateKey: 'private:123', userId: '123', contextForQQ: () => '',
+    syncPrivateContext() {}, recordQQ() {} });
+  const server = h.startConsoleServer();
+  if (!server.listening) await new Promise(resolve => server.once('listening', resolve));
+  const origin = 'http://127.0.0.1:' + server.address().port;
+  const request = async (route, body) => {
+    const response = await fetch(origin + '/api/socialV2/' + route + '?key=private:123', {
+      method: body ? 'POST' : 'GET', headers: { 'x-console-token': 'fixture-console-token', 'content-type': 'application/json' },
+      ...(body ? { body: JSON.stringify({ key: 'private:123', ...body }) } : {}),
+    });
+    const data = await response.json();
+    assert.equal(response.status, 200, JSON.stringify(data));
+    return data;
+  };
+  try {
+    const prompt = await request('prompt');
+    const persona = readSharedPersona();
+    assert.equal(prompt.sharedPersona.hash, persona.hash);
+    assert.equal(prompt.role.hint, persona.text);
+    await h.deliverPrompt('private:123', '本轮私聊消息');
+    assert(h.calls.prompts.at(-1).content[0].text.includes(persona.text));
+    await request('long-memory/append', { name: '123', text: '喜欢：红茶' });
+    const hardwareMemory = createProfileMemory({ file: path.join(h.temp, 'state/long-term/people.md') });
+    assert(hardwareMemory.format({ names: ['QQ:123'] }).includes('红茶'));
+    hardwareMemory.write('QQ:123', '近况：在准备课程');
+    hardwareMemory.write('QQ:99999', '秘密：不应混入');
+    const read = await request('long-memory');
+    assert(read.text.includes('在准备课程'));
+    assert(!read.text.includes('不应混入'));
+    const groupHeaders = { 'x-console-token': 'fixture-console-token',
+      'x-agent-token': h.getSocialV2State('group:456').agentToken, 'content-type': 'application/json' };
+    const groupRead = await fetch(origin + '/api/socialV2/long-memory?key=group:456', { headers: groupHeaders });
+    const groupMemory = await groupRead.json();
+    assert.equal(groupRead.status, 200);
+    assert(!groupMemory.text.includes('红茶') && !groupMemory.text.includes('不应混入'));
+    const groupWrite = await fetch(origin + '/api/socialV2/long-memory/append', { method: 'POST', headers: groupHeaders,
+      body: JSON.stringify({ key: 'group:456', name: 'QQ:123', text: '喜欢：被群聊覆盖' }) });
+    assert.equal(groupWrite.status, 403);
+    await request('long-memory/remove', { name: '123', text: '喜欢' });
+    assert(!hardwareMemory.format({ names: ['QQ:123'] }).includes('红茶'));
+  } finally {
+    await new Promise(resolve => server.close(resolve));
+    await h.close();
+  }
+});
