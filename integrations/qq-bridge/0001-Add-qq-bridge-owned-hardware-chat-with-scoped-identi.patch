+    getPrivateState: key => { assert.equal(key, 'private:12345'); return privateState; }, memory,
+    store: new HardwareContextStore(file), hostRequest: async (endpoint, body) => {
+      hostCalls.push({ endpoint, body });
+      if (endpoint === '/api/control/speak') return { action_id: 'ctl-' + 'a'.repeat(32), state: 'accepted' };
+      if (endpoint.startsWith('/api/control/actions/')) return { state: actionState, playback_confirmed: actionState === 'completed' };
+      return { state: 'cancelled' };
+    },
+  });
+  return { root, cfg, channel, api, prompts, hostCalls, cancelledSessions, createdPresets, memory,
+    async close() { await channel.close(); fs.rmSync(root, { recursive: true }); } };
+}
+
+test('bound private context/persona, single hardware output, no group or foreign memory', async () => {
+  const f = fixture();
+  try {
+    const body = { device_id: 'pet-1', session_id: 'mic-1', transcript: '你记得我在准备什么吗？', user_id: '99999' };
+    const accepted = await f.channel.accept(body);
+    await until(() => f.channel.snapshot(accepted.turn_id).state === 'completed');
+    const prompt = f.prompts[0].content[0].text;
+    assert(prompt.includes('我在准备交通课程') && prompt.includes('昵称：豆豆') && prompt.includes('现有人格'));
+    assert(!prompt.includes('FORBIDDEN_OTHER_USER') && !prompt.includes('他人私密'));
+    assert.equal(f.channel.snapshot(accepted.turn_id).user_id, '12345');
+    assert.deepEqual(f.createdPresets, ['qq-hardware']);
+    assert.equal(f.hostCalls.filter(c => c.endpoint === '/api/control/speak').length, 1);
+    assert.equal(f.hostCalls.find(c => c.body?.text)?.body.input_session_id, 'mic-1');
+    assert.equal(f.channel.contextForQQ('group:12345'), '');
+    assert.equal(f.channel.contextForQQ('private:99999'), '');
+    assert(f.channel.contextForQQ('private:12345').includes('记得你在准备交通课程'));
+    assert(!f.memory.format().includes('昵称：豆豆'));
+    assert(f.memory.format({ personQQ: '12345' }).includes('昵称：豆豆'));
+    await f.channel.accept(body);
+    assert.equal(f.prompts.length, 1, 'HTTP retry must not generate another reply');
+    await assert.rejects(f.channel.accept({ ...body, transcript: 'changed' }), /INPUT_ID_CONFLICT/);
+  } finally { await f.close(); }
+});
+
+test('hardware model work does not wait for an unrelated QQ long poll', async () => {
+  const f = fixture({ reply: false });
+  try {
+    const neverCompletedQQWait = new Promise(() => {});
+    f.api.qqLongPoll = neverCompletedQQWait;
+    const first = await f.channel.accept({ device_id: 'pet-1', session_id: 'mic-1', transcript: '你好' });
+    await until(() => f.prompts.length === 1);
+    const token = f.channel.live.get(first.turn_id).token;
+    await f.channel.cancel(first.turn_id);
+    await assert.rejects(f.channel.reply({ turn_id: first.turn_id, turn_token: token, text: '迟到回复' }), /STALE_OR_INVALID/);
+    assert.equal(f.hostCalls.filter(c => c.endpoint === '/api/control/speak').length, 0);
+    const next = await f.channel.accept({ device_id: 'pet-1', session_id: 'mic-2', transcript: '新问题' });
+    await until(() => f.prompts.length === 2);
+    assert.equal(f.channel.onEvent('qq-private-session', { type: 'turn/end', data: { reason: { kind: 'completed' } } }), false);
+    assert(f.cancelledSessions.every(id => id.startsWith('hardware-session-')));
+    await f.channel.cancel(next.turn_id);
+  } finally { await f.close(); }
+});
+
+test('failed/offline output is never committed as spoken memory or replayed', async () => {
+  const f = fixture({ actionState: 'failed' });
+  try {
+    const body = { device_id: 'pet-1', session_id: 'mic-offline', transcript: '测试离线' };
+    const accepted = await f.channel.accept(body);
+    await until(() => f.channel.snapshot(accepted.turn_id).state === 'failed');
+    assert(!f.channel.contextForQQ('private:12345').includes('记得你在准备交通课程'));
+    await f.channel.accept(body);
+    assert.equal(f.prompts.length, 1);
+    assert(!f.channel.snapshot(accepted.turn_id).playback_confirmed);
+  } finally { await f.close(); }
+});
+
+test('a device interruption remains cancelled rather than a model/service failure', async () => {
+  const f = fixture({ actionState: 'cancelled' });
+  try {
+    const accepted = await f.channel.accept({ device_id: 'pet-1', session_id: 'interrupted', transcript: '先听我说' });
+    await until(() => f.channel.snapshot(accepted.turn_id).state === 'cancelled');
+    assert.equal(f.channel.snapshot(accepted.turn_id).error, 'OUTPUT_INTERRUPTED');
+    assert(!f.channel.contextForQQ('private:12345').includes('记得你在准备交通课程'));
+  } finally { await f.close(); }
+});
+
+test('memory writes require current user evidence and use existing scoped memory', async () => {
+  const f = fixture({ reply: false });
+  try {
+    const row = await f.channel.accept({ device_id: 'pet-1', session_id: 'mic-memory', transcript: '记住我喜欢红茶' });
+    await until(() => f.prompts.length === 1);
+    const scope = { turn_id: row.turn_id, turn_token: f.channel.live.get(row.turn_id).token };
+    assert.throws(() => f.channel.memoryTool({ ...scope, operation: 'write', text: '喜好：咖啡', evidence: '我喜欢咖啡' }), /EVIDENCE/);
+    f.channel.memoryTool({ ...scope, operation: 'write', text: '喜好：红茶', evidence: '我喜欢红茶' });
+    assert(f.channel.scopedMemory().includes('喜好：红茶'));
+    assert(!f.memory.format({ personQQ: '99999' }).includes('喜好：红茶'));
+    await f.channel.cancel(row.turn_id);
+  } finally { await f.close(); }
+});
+
+test('gateway rejects wrong credentials/devices and recovers without replay after restart', async () => {
+  const f = fixture({ reply: false });
+  try {
+    const row = f.channel.store.create({ deviceId: 'pet-1', sessionId: 'pending', userId: '12345', transcript: '旧录音' }).row;
+    f.channel.store.update(row.id, { dsh_session: 'qq-session-must-not-cancel' });
+    await f.channel.start();
+    assert.equal(f.channel.snapshot(row.id).state, 'failed');
+    assert(!f.cancelledSessions.includes('qq-session-must-not-cancel'));
+    const origin = 'http://127.0.0.1:' + f.channel.server.address().port;
+    assert.equal((await fetch(origin + '/health')).status, 401);
+    const headers = { authorization: 'Bearer test-gateway-token', 'content-type': 'application/json' };
+    assert.equal((await fetch(origin + '/v1/hardware/turn', { method: 'POST', headers,
+      body: JSON.stringify({ device_id: 'other', session_id: 'mic-1', transcript: 'bad' }) })).status, 403);
+    const retried = await f.channel.accept({ device_id: 'pet-1', session_id: 'pending', transcript: '旧录音' });
+    assert.equal(retried.state, 'failed');
+    assert.equal(f.prompts.length, 0);
+  } finally { await f.close(); }
+});
+
+test('dedicated hardware preset denies QQ waits, generic hardware and local tools', () => {
+  let guard, restricted;
+  applyGuard({ tools: { restrict: value => { restricted = value; }, guard: callback => { guard = callback; } } });
+  assert(allowedHardwareTool('mcp__companion-hardware__hardware_reply'));
+  for (const name of ['pwsh', 'read', 'mcp__snowluma__qq_send_message', 'mcp__snowluma__qq_wait_for_messages', 'mcp__toppet__device_speak']) {
+    assert(guard({ name }), name);
+  }
+  assert.equal(guard({ name: 'mcp__companion-hardware__hardware_reply' }), undefined);
+  assert.equal(restricted.allow.length, 3);
+});
+
+test('new physical input never queues behind a previous hardware model still finishing', async () => {
+  const f = fixture();
+  try {
+    const first = await f.channel.accept({ device_id: 'pet-1', session_id: 'first', transcript: '第一句' });
+    await until(() => f.channel.snapshot(first.turn_id).state === 'completed');
+    // No model turn/end was delivered yet: speech can finish before the model.
+    const second = await f.channel.accept({ device_id: 'pet-1', session_id: 'second', transcript: '第二句' });
+    await until(() => f.channel.snapshot(second.turn_id).state === 'completed');
+    assert.equal(f.createdPresets.length, 2);
+    assert.notEqual(f.prompts[0].sessionId, f.prompts[1].sessionId);
+    assert(f.cancelledSessions.includes(f.prompts[0].sessionId));
+    f.channel.onEvent(f.prompts[0].sessionId, { type: 'turn/end', data: { turn: 1, reason: { kind: 'aborted' } } });
+    assert.equal(f.channel.snapshot(second.turn_id).state, 'completed');
+  } finally { await f.close(); }
+});
+
+test('model audit keeps tool names but never persists turn-token arguments', async () => {
+  const f = fixture({ reply: false });
+  try {
+    const accepted = await f.channel.accept({ device_id: 'pet-1', session_id: 'audit', transcript: '测试审计' });
+    await until(() => f.prompts.length === 1);
+    const token = f.channel.live.get(accepted.turn_id).token;
+    f.channel.onEvent(f.prompts[0].sessionId, { type: 'tool/call', data: {
+      turn: 1, callId: 'call-1', name: 'mcp__companion-hardware__hardware_reply', arguments: { turn_token: token },
+    } });
+    const audit = JSON.stringify(f.channel.snapshot(accepted.turn_id).model_events);
+    assert(audit.includes('mcp__companion-hardware__hardware_reply'));
+    assert(!audit.includes(token));
+    await f.channel.cancel(accepted.turn_id);
+  } finally { await f.close(); }
+});
