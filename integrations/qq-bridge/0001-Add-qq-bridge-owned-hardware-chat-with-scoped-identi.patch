+// 验证 qq-tool-restrict 的时序逻辑（2026-10-26，DSH 0.2.1-rc.3 现场复现）：
+//   · preset apply 时全局层只有 4 个工具，其余名字「此刻不存在」⇒ unknown 属预期；
+//   · 晚 2.5 秒注册进来的危险工具，必须在后续轮次被补藏；
+//   · 失败日志不能把 DSH 那句两万字符的「known global tools」原样打出来；
+//   · 执行期 guard 必须始终可用，且默认拒绝本地工具。
+//
+// 全程用假 ctx，不加载 DSH、不启真服务。运行约 16 秒（依赖真实 setTimeout 节奏）。
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const LOG = path.join(os.tmpdir(), `qq-tool-restrict-test-${process.pid}.log`)
+process.env.QQ_TOOL_RESTRICT_LOG = LOG
+try { fs.rmSync(LOG, { force: true }) } catch {}
+
+const mod = await import(pathToFileURL(path.join(ROOT, 'plugins/qq-agent-presets/qq-tool-restrict.mjs')).href)
+
+// —— 模拟宿主：全局层初始只有 4 个工具，2.5 秒后再注册一批危险工具 ——
+const EARLY = ['list_mcp_resource_templates', 'list_mcp_resources', 'read_mcp_resource', 'working_directory']
+const LATE = ['pwsh', 'read', 'write', 'edit', 'glob', 'grep', 'job_list', 'terminal_open', 'session_search', 'plugin_market']
+const registered = new Set(EARLY)
+const restricted = new Map()
+let guardFn = null
+
+const fakeCtx = {
+  tools: {
+    restrict({ deny }) {
+      for (const name of deny) {
+        if (!registered.has(name)) throw new Error(`tools.restrict() names unknown global tool "${name}"; known global tools: ${[...registered].join(', ')}`)
+        restricted.set(name, true)
+      }
+    },
+    guard(fn) {
+      guardFn = fn
+    },
+  },
+}
+
+const errors = []
+const origError = console.error
+console.error = (...args) => { errors.push(args.join(' ')); origError(...args) }
+
+mod.apply(fakeCtx)
+
+setTimeout(() => {
+  for (const name of LATE) registered.add(name)
+}, 2500)
+
+setTimeout(() => {
+  console.error = origError
+  const expected = new Set([...EARLY, ...LATE])
+  const missing = [...expected].filter((n) => !restricted.has(n))
+  const overRestricted = [...restricted.keys()].filter((n) => !expected.has(n))
+
+  console.log(`\n已隐藏 ${restricted.size}/${mod.RESTRICTED_TOOL_NAMES.length}`)
+  console.log(`预期 ${expected.size}；漏藏 ${missing.length}；误藏 ${overRestricted.length}`)
+  console.log(`错误日志 ${errors.length} 条，最长 ${Math.max(0, ...errors.map((e) => e.length))} 字符`)
+
+  assert.equal(missing.length, 0, `这些晚注册的工具没被补藏：${missing.join(', ')}`)
+  assert.equal(overRestricted.length, 0, `误藏了不在模拟集合里的名字：${overRestricted.join(', ')}`)
+  assert.ok(errors.every((e) => e.length < 400), '失败日志里仍然出现了超长报错（DSH 的 known global tools 原文）')
+
+  // guard：默认拒绝本地工具，放行白名单
+  assert.equal(typeof guardFn, 'function', 'guard 没有注册')
+  assert.ok(guardFn({ name: 'pwsh' }), 'guard 应当拒绝 pwsh')
+  assert.ok(guardFn({ name: 'read' }), 'guard 应当拒绝 read')
+  assert.equal(guardFn({ name: 'mcp__snowluma__qq_send_message' }), undefined, 'guard 应放行 snowluma MCP 工具')
+  assert.equal(guardFn({ name: 'todo_write' }), undefined, 'guard 应放行 todo_write')
+
+  const diag = fs.existsSync(LOG) ? fs.readFileSync(LOG, 'utf8') : ''
+  assert.ok(/最终隐藏/.test(diag), '诊断文件里缺少最终统计行')
+
+  console.log('\nPASS: 时序补藏、失败分类、guard 边界与日志长度均符合预期')
+  process.exit(0)
+}, 16_500)
