+      fs.mkdirSync(dir, { recursive: true });
+      const workspace = unwrap(await this.api.workspace.create({ path: dir }), 'hardware workspace.create');
+      const result = unwrap(await this.api.sessions.create({ workspaceId: workspace.workspace.workspaceId,
+        agentPreset: this.cfg.preset ?? 'qq-hardware' }), 'hardware session.create');
+      this.sessionOwners.add(result.sessionId);
+      this.api.events.follow(result.sessionId);
+      if (await this.ensureModel(result.sessionId) === 'failed') throw fail('HARDWARE_MODEL_UNAVAILABLE');
+      this.store.saveSession(binding, result.sessionId, hash);
+      return result.sessionId;
+    };
