index 0000000..4d5ed33
--- /dev/null
+++ b/src/mcp-toppet.js
@@ -0,0 +1,81 @@
+// Local TopPet hardware tools for DSH. No QQ delivery or identity binding here.
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
+import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
+import { z } from 'zod';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const configPath = process.env.TOPPET_MCP_CONFIG || path.join(root, 'toppet.local.json');
+function configuration() {
+  const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
+  const url = new URL(config.hostUrl);
+  if (url.protocol !== 'http:' || !['127.0.0.1', '[::1]'].includes(url.hostname)
+      || url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
+    throw new Error('TopPet hostUrl must be a literal loopback HTTP origin');
+  }
+  if (!Array.isArray(config.deviceIds) || !config.deviceIds.length
+      || config.deviceIds.some(id => typeof id !== 'string' || !id.trim())) {
+    throw new Error('TopPet deviceIds must explicitly list allowed devices');
+  }
+  const token = fs.readFileSync(config.tokenFile, 'utf8').trim();
+  if (!token) throw new Error('TopPet control token is empty');
+  return { ...config, origin: url.origin, token };
+}
+
+async function call(endpoint, body) {
+  const config = configuration();
+  if (body?.device_id && !config.deviceIds.includes(body.device_id)) {
+    throw new Error('Device is not enabled in the local TopPet configuration');
+  }
+  const response = await fetch(config.origin + endpoint, {
+    method: body ? 'POST' : 'GET', redirect: 'error',
+    headers: { authorization: `Bearer ${config.token}`, 'content-type': 'application/json' },
+    ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(5000),
+  });
+  const result = await response.json();
+  if (!response.ok) throw new Error(`TopPet HTTP ${response.status}: ${JSON.stringify(result.detail ?? 'request failed')}`);
+  if (endpoint === '/api/control/devices') {
+    result.devices = result.devices.filter(d => config.deviceIds.includes(d.device_id));
+  } else if (result.device_id && !config.deviceIds.includes(result.device_id)) {
+    throw new Error('Action belongs to a device that is not enabled');
+  }
+  return result;
+}
+
+const server = new McpServer({ name: 'toppet', version: '0.1.0' });
+function tool(name, description, schema, callback) {
+  server.tool(name, description, schema, async args => {
+    try {
+      return { content: [{ type: 'text', text: JSON.stringify(await callback(args)) }] };
+    } catch (error) {
+      // Never return config paths, authorization headers or raw network exceptions.
+      const message = String(error?.message ?? 'hardware tool failed');
+      const safe = /^(TopPet HTTP|Device is not|Action belongs)/.test(message)
+        ? message : 'TopPet unavailable: check host service and local tool configuration';
+      return { isError: true, content: [{ type: 'text', text: safe }] };
+    }
+  });
+}
+
+tool('device_status', '查询已允许的 TopPet 设备是否在线、是否支持远程控制及当前动作。', {},
+  () => call('/api/control/devices'));
+tool('device_speak', '让指定桌宠用已配置的克隆声音说话并显示字幕表情。先查询设备。返回 accepted 仅表示接受任务；用 device_action 查询结果，只有 playback_confirmed=true 才表示设备报告播放完成。重复请求复用同一个 request_id；相同内容的新请求使用新的 request_id。', {
+  device_id: z.string().min(1).max(128),
+  text: z.string().trim().min(1).max(120),
+  emotion: z.enum(['NEUTRAL', 'HAPPY', 'HEART', 'SHY', 'SAD', 'ANGRY', 'SURPRISED', 'SLEEPY', 'WORKING', 'GREETING', 'CELEBRATE', 'READING', 'EATING', 'DRINKING', 'COOL']).default('NEUTRAL'),
+  request_id: z.string().min(1).max(96).describe('每个新请求的唯一编号；网络重试保持不变'),
+}, args => call('/api/control/speak', args));
+tool('device_action', '查询一次设备动作。completed 且 playback_confirmed=true 表示设备报告播放完成，failed/cancelled 不能说成已说完。', {
+  action_id: z.string().regex(/^ctl-[a-f0-9]{32}$/),
+}, args => call('/api/control/actions/' + args.action_id));
+tool('device_stop', '停止指定的设备动作，不取消 DSH 会话或 QQ 对话。', {
+  action_id: z.string().regex(/^ctl-[a-f0-9]{32}$/),
+}, async args => {
+  // Check the action's device allowlist before causing any effect.
+  await call('/api/control/actions/' + args.action_id);
+  return call('/api/control/stop', args);
+});
+
+await server.connect(new StdioServerTransport());
diff --git a/start-dsh-local.ps1 b/start-dsh-local.ps1
new file mode 100644
index 0000000..22320ec
