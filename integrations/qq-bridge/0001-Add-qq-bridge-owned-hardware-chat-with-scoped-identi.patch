+    const operation = async () => {
+      const binding = this.userId + ':' + this.deviceId;
+      const hash = digest(persona.name + '\0' + persona.text);
+      const saved = this.store.session(binding);
+      if (saved && saved.persona_hash === hash && this.idleSessions.has(saved.session_id)) {
+        try {
+          const ready = await this.ensureModel(saved.session_id);
+          if (ready !== 'not-found' && ready !== 'failed') {
+            this.sessionOwners.add(saved.session_id);
+            this.api.events.follow(saved.session_id);
+            return saved.session_id;
+          }
+        } catch {}
+      }
+      if (saved) this.retireSession(saved.session_id);
