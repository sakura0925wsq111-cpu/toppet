index 0000000..a6f6b85
--- /dev/null
+++ b/scripts/export-dsh-tool-sources.mjs
@@ -0,0 +1,24 @@
+// Read installed engine packages through Electron's ASAR-aware Node runtime.
+// Audit copies are D-drive cache data, not a second engine installation.
+import fs from 'node:fs';
+import path from 'node:path';
+const source = process.env.DSH_ASAR_PACKAGES || path.join(path.dirname(process.execPath), 'resources',
+  'app.asar', 'dsh', 'node_modules', '@deepseek-ai');
+const destination = process.env.DSH_AUDIT_EXPORT || 'D:/dafeiyu/runtime-data/cache/dsh-tool-sources';
+if (!fs.existsSync(source)) throw new Error('Run with ELECTRON_RUN_AS_NODE=1 and the installed DeepSeek Harness executable');
+let copied = 0;
+function copyDirectory(from, to) {
+  fs.mkdirSync(to, { recursive: true });
+  for (const entry of fs.readdirSync(from, { withFileTypes: true })) {
+    if (entry.name === 'node_modules') continue;
+    const input = path.join(from, entry.name), output = path.join(to, entry.name);
+    if (entry.isDirectory()) copyDirectory(input, output);
+    else if (/\.(?:[cm]?js|json|ya?ml)$/.test(entry.name)) { fs.copyFileSync(input, output); copied++; }
+  }
+}
+for (const name of fs.readdirSync(source)) {
+  if (name.startsWith('dsh-') && fs.statSync(path.join(source, name)).isDirectory()) {
+    copyDirectory(path.join(source, name), path.join(destination, name));
+  }
+}
+console.log(JSON.stringify({ exported: true, files: copied, destination }));
