+  const privateState = { recentMessages: [
+    { messageId: 'qq-1', userId: '12345', isSelf: false, text: '我在准备交通课程', time: 1 },
+    { messageId: 'qq-2', isSelf: true, text: '好，我记得。', time: 2 },
+    { messageId: 'forged', userId: '99999', text: 'FORBIDDEN_OTHER_USER', time: 3 },
