+// A real qq-bridge channel: bridge-owned identity, persona, context and routing.
+import fs from 'node:fs';
+import http from 'node:http';
+import path from 'node:path';
+import { randomBytes, timingSafeEqual } from 'node:crypto';
+import { HardwareContextStore, digest, turnId, renderPersonalContext } from './hardware-context-store.js';
+import { unwrap } from './dsh-client.js';
+import { allowedHardwareTool } from './hardware-tool-restrict.mjs';
+
+const TERMINAL = new Set(['completed', 'failed', 'cancelled']);
+const equal = (a, b) => typeof a === 'string' && typeof b === 'string' && a.length > 0
+  && Buffer.byteLength(a) === Buffer.byteLength(b) && timingSafeEqual(Buffer.from(a), Buffer.from(b));
+const pause = ms => new Promise(resolve => setTimeout(resolve, ms));
+const fail = (message, status = 409) => Object.assign(new Error(message), { status });
+const validLocalOrigin = raw => {
+  const url = new URL(raw);
+  if (url.protocol !== 'http:' || url.hostname !== '127.0.0.1' || url.username || url.password
+      || url.pathname !== '/' || url.search || url.hash) throw fail('LOCAL_ORIGIN_REQUIRED', 400);
+  return url.origin;
+};
+
+export class HardwareChannel {
+  constructor({ root, config, api, ensureModel, isReady, getPersona, getPrivateState,
+    memory, log = () => {}, hostRequest, store }) {
+    this.root = root;
+    this.cfg = config;
+    this.userId = String(config.userQQ);
+    this.deviceId = config.deviceId;
+    if (!/^\d{5,15}$/.test(this.userId) || !this.deviceId || config.preset !== 'qq-hardware') {
+      throw fail('INVALID_HARDWARE_BINDING_OR_PRESET', 400);
+    }
+    this.privateKey = 'private:' + this.userId;
+    this.api = api;
+    this.ensureModel = ensureModel;
+    this.isReady = isReady;
+    this.getPersona = getPersona;
+    this.getPrivateState = getPrivateState;
+    this.memory = memory;
+    this.log = log;
+    this.hostOrigin = validLocalOrigin(config.hostUrl);
+    this.store = store ?? new HardwareContextStore(path.join(root, 'state', 'hardware-context.sqlite'));
+    this.token = fs.readFileSync(config.gatewayTokenFile, 'utf8').trim();
+    this.live = new Map();
+    this.activeByDevice = new Map();
+    this.sessionOwners = new Set(this.store.ownedSessions());
+    this.idleSessions = new Set();
+    this.sessionLock = Promise.resolve();
+    this.hostRequest = hostRequest ?? (async (endpoint, body) => {
+      const token = fs.readFileSync(config.hostTokenFile, 'utf8').trim();
+      const response = await fetch(this.hostOrigin + endpoint, {
+        method: body ? 'POST' : 'GET', headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
+        ...(body ? { body: JSON.stringify(body) } : {}), redirect: 'error', signal: AbortSignal.timeout(6000),
+      });
+      const value = await response.json();
+      if (!response.ok) throw fail(typeof value.detail === 'string' ? value.detail : 'HOST_REQUEST_FAILED');
+      return value;
+    });
+  }
+  async start() {
+    // Never replay accepted speech or model requests after a bridge restart.
+    for (const row of this.store.pending()) {
+      this.store.update(row.id, { state: 'failed', error: 'BRIDGE_RESTARTED' });
+      if (row.action_id) await this.hostRequest('/api/control/stop', { action_id: row.action_id }).catch(() => {});
+      if (row.dsh_session) this.retireSession(row.dsh_session);
+    }
+    this.server = http.createServer((request, response) => this.handle(request, response));
+    await new Promise((resolve, reject) => {
+      this.server.once('error', reject);
+      this.server.listen(this.cfg.port, '127.0.0.1', resolve);
+    });
+    this.log('hardware channel ready', { deviceId: this.deviceId, userQQ: this.userId, port: this.cfg.port });
+  }
+  syncPrivateContext() {
+    const state = this.getPrivateState(this.privateKey);
+    return this.store.importPrivate(this.userId, this.privateKey, state?.recentMessages ?? []);
+  }
+  scopedMemory() {
+    const sectionName = 'QQ:' + this.userId;
+    const sections = (this.memory?.read().sections ?? []).filter(section => section.name === sectionName);
+    return sections.map(section => section.notes.map(note => note.text).join('\n')).join('\n').slice(0, 1600);
+  }
+  contextForQQ(key) {
+    if (key !== this.privateKey) return '';
+    const history = renderPersonalContext(this.store.context(this.userId, { channel: 'hardware', limit: 12 }), 2200);
+    const memory = this.scopedMemory();
+    return [history, memory ? '【此用户共享记忆】\n' + memory : '',
+      history ? '以上当面聊天仅是背景；本次仍只回复当前QQ消息，不向硬件输出。' : ''].filter(Boolean).join('\n');
+  }
+  recordQQ(key, role, text, eventId = '') {
+    if (key !== this.privateKey || !String(text).trim()) return;
+    const id = 'qq-live:' + digest(key + '\0' + role + '\0' + (eventId || Date.now()) + '\0' + text);
+    this.store.message(id, this.userId, 'qq', role, text, role === 'assistant' ? 'sent' : 'received');
+  }
+  snapshot(id) {
+    const row = this.store.get(id);
+    if (!row) throw fail('UNKNOWN_HARDWARE_TURN', 404);
+    return { turn_id: row.id, device_id: row.device_id, user_id: row.user_id,
+      input_session_id: row.input_session, state: row.state, error: row.error,
+      dsh_session_id: row.dsh_session, action_id: row.action_id, reply: row.reply,
+      context: row.context_meta ? JSON.parse(row.context_meta) : null,
+      model_events: this.store.audits(id),
+      playback_confirmed: row.state === 'completed', output_channel: 'hardware' };
+  }
+  async accept(body) {
+    if (body.device_id !== this.deviceId || !/^[\w-]{1,47}$/.test(String(body.session_id ?? ''))) throw fail('UNBOUND_DEVICE_OR_SESSION', 403);
+    const transcript = String(body.transcript ?? '').trim();
+    if (!transcript || transcript.length > 1600) throw fail('INVALID_TRANSCRIPT', 422);
+    const { row, created } = this.store.create({ deviceId: this.deviceId, sessionId: body.session_id,
+      userId: this.userId, transcript });
+    if (!created) return this.snapshot(row.id);
