@@ -0,0 +1,159 @@
+// 长期记忆 · 人物档案：分节存储、字段覆盖、注入预算、坏文件容错、沉淀解析。
+//
+// 重点盯「档案会不会写歪」：同字段必须覆盖而不是堆两条、超预算按整人丢、
+// 手改坏了的文件不能让桥接起不来。任何一条退化，记忆都会变成矛盾的流水账。
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createProfileMemory, buildConsolidationPrompt, parseConsolidationJson } from '../src/long-term-memory.js';
+
+function tempMemory(opts = {}) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'qq-lt-'));
+  const file = path.join(dir, 'people.md');
+  return { dir, file, mem: createProfileMemory({ file, ...opts }) };
+}
+
+test('写入一条 → 按人分节 → 字段与内容都能读回', () => {
+  const { mem, file } = tempMemory();
+  const r = mem.write('阿杰', '喜欢：明日方舟，抽卡很非');
+  assert.equal(r.ok, true);
+  assert.equal(r.created, true);
+  const { sections } = mem.read();
+  assert.equal(sections.length, 1);
+  assert.equal(sections[0].name, '阿杰');
+  assert.equal(sections[0].notes[0].text, '喜欢：明日方舟，抽卡很非');
+  assert.ok(fs.existsSync(file));
+  assert.match(fs.readFileSync(file, 'utf8'), /## 阿杰/);
+});
+
+test('同字段再写是覆盖，不是新增', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '近况：在准备考研');
+  const r = mem.write('阿杰', '近况：考完了在找工作');
+  assert.equal(r.replaced, true);
+  const notes = mem.read().sections[0].notes;
+  assert.equal(notes.length, 1);
+  assert.equal(notes[0].text, '近况：考完了在找工作');
+});
+
+test('同人不同字段追加；不同人各自分节', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '喜欢：明日方舟');
+  mem.write('阿杰', '雷区：别叫他全名');
+  mem.write('小鱼', '近况：在准备复试');
+  const { sections } = mem.read();
+  assert.equal(sections.length, 2);
+  assert.equal(sections[0].notes.length, 2);
+  assert.equal(sections[1].name, '小鱼');
+});
+
+test('完全重复的条目不会写两遍', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '喜欢：明日方舟');
+  const r = mem.write('阿杰', '  喜欢：明日方舟  ');
+  assert.equal(r.unchanged, true);
+  assert.equal(mem.read().sections[0].notes.length, 1);
+});
+
+test('没有字段的条目也能存（自由记录）', () => {
+  const { mem } = tempMemory();
+  mem.write('通用', '这个群主要聊游戏和番剧');
+  assert.equal(mem.read().sections[0].notes[0].text, '这个群主要聊游戏和番剧');
+});
+
+test('name 为空落到「通用」', () => {
+  const { mem } = tempMemory();
+  mem.write('', '群里半夜最活跃');
+  assert.equal(mem.read().sections[0].name, '通用');
+});
+
+test('forget 删条目；删到最后一条时整人档案一起消失', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '喜欢：明日方舟');
+  mem.write('阿杰', '雷区：别叫他全名');
+  assert.equal(mem.forget('阿杰', '明日方舟').removed, 1);
+  assert.equal(mem.read().sections[0].notes.length, 1);
+  const r = mem.forget('阿杰', '别叫他全名');
+  assert.equal(r.removedSection, '阿杰');
+  assert.equal(mem.read().sections.length, 0);
+});
+
+test('forget 只传 name 时删除整份档案', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '喜欢：明日方舟');
+  mem.write('小鱼', '近况：在准备复试');
+  const r = mem.forget('阿杰');
+  assert.equal(r.removedSection, '阿杰');
+  assert.deepEqual(mem.read().sections.map((s) => s.name), ['小鱼']);
+});
+
+test('forget 找不到时不抛错', () => {
+  const { mem } = tempMemory();
+  assert.equal(mem.forget('不存在', '随便').ok, false);
+});
+
+test('format 超预算时整节丢人，不把某人的档案切一半', () => {
+  const { mem } = tempMemory();
+  for (let i = 0; i < 8; i += 1) mem.write(`人${i}`, `喜欢：${'很长的内容'.repeat(4)}`);
+  const block = mem.format({ maxChars: 300 });
+  assert.ok(block.startsWith('【长期记忆 · 人物档案】'));
+  // 每个出现的 ## 小节都必须是完整的（至少带一条 - 条目）
+  const names = block.match(/^## .+$/gm) || [];
+  assert.ok(names.length >= 1);
+  assert.ok(block.length < 600, `注入块不应膨胀（实际 ${block.length}）`);
+});
+
+test('没有档案时 format 返回空串', () => {
+  const { mem } = tempMemory();
+  assert.equal(mem.format({ maxChars: 1200 }), '');
+});
+
+test('手写成没有 ## 小节的文件也能读（归到通用）', () => {
+  const { mem, file } = tempMemory();
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, '# 标题\n- 阿杰喜欢明日方舟\n', 'utf8');
+  const { sections } = mem.read();
+  assert.equal(sections.length, 1);
+  assert.equal(sections[0].name, '通用');
+  assert.equal(sections[0].notes[0].text, '阿杰喜欢明日方舟');
+});
+
+test('文件不存在 / 无法解析时不抛错', () => {
+  const { mem } = tempMemory();
+  assert.deepEqual(mem.read().sections, []);
+  assert.equal(mem.stats().people, 0);
+});
+
+test('stats 给出人数与条目数', () => {
+  const { mem } = tempMemory();
+  mem.write('阿杰', '喜欢：明日方舟');
+  mem.write('小鱼', '近况：在准备复试');
+  assert.deepEqual(mem.stats().names.sort(), ['小鱼', '阿杰'].sort());
+  assert.equal(mem.stats().notes, 2);
+});
+
+test('沉淀提示词：带现有档案、字段格式与禁令', () => {
+  const prompt = buildConsolidationPrompt({
+    existing: { sections: [{ name: '阿杰', notes: [{ text: '喜欢：明日方舟' }] }] },
+    messages: [{ sender: '阿杰', text: '今天又歪了' }]
+  });
+  assert.ok(prompt.includes('## 阿杰'));
+  assert.ok(prompt.includes('喜欢：明日方舟'));
+  assert.ok(prompt.includes('[阿杰] 今天又歪了'));
+  assert.ok(prompt.includes('字段：内容'));
+  assert.ok(prompt.includes('只输出 JSON'));
+});
+
+test('沉淀结果解析：people/drop、代码块包裹、坏输出退化', () => {
+  const a = parseConsolidationJson('{"people":[{"name":"阿杰","notes":["喜欢：明日方舟"]}],"drop":["旧条目"]}');
+  assert.deepEqual(a.people, [{ name: '阿杰', notes: ['喜欢：明日方舟'] }]);
+  assert.deepEqual(a.drop, ['旧条目']);
+
+  const b = parseConsolidationJson('```json\n{"people":[{"name":"小鱼","notes":["近况：复试"]}],"drop":[]}\n```');
+  assert.equal(b.people[0].name, '小鱼');
+
+  assert.deepEqual(parseConsolidationJson('不是 JSON'), { people: [], drop: [] });
+  assert.deepEqual(parseConsolidationJson('{"people":[{"name":"","notes":["x"]}]}'), { people: [], drop: [] });
+});
