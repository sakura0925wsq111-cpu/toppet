+# D-only data/cache/log paths; same installed DSH engine and migrated configuration.
+$ErrorActionPreference = 'Stop'
+$taskHome = 'D:\dafeiyu\dsh-home'
+$taskRuntime = 'D:\dafeiyu\runtime-data'
+$taskPort = 8784
+$taskPortOwner = Get-NetTCPConnection -LocalPort $taskPort -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1
+if ($taskPortOwner) {
+    $taskProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$($taskPortOwner.OwningProcess)"
+    if ($taskProcess.CommandLine -notmatch 'dsh-desktop-host[/\\]lib[/\\]cli.js' -or $taskProcess.CommandLine -notmatch 'companion') {
+        throw 'Port 8784 belongs to another service.'
+    }
+    [ordered]@{ status='ready'; pid=$taskPortOwner.OwningProcess; port=$taskPort; home=$taskHome } | ConvertTo-Json -Compress
+    return
+}
+if (-not (Test-Path -LiteralPath (Join-Path $taskHome 'profiles\companion\package.json'))) {
+    throw 'The D-drive DSH home/profile has not been migrated.'
+}
+$env:DSH_HOME = $taskHome
+$env:DSH_AGENTS_HOME = Join-Path $taskRuntime 'agents'
+$env:QQ_BRIDGE_DSH_PROFILE = 'companion'
+$env:TEMP = Join-Path $taskRuntime 'temp'
+$env:TMP = $env:TEMP
+$env:XDG_CACHE_HOME = Join-Path $taskRuntime 'cache'
+$env:NODE_COMPILE_CACHE = Join-Path $taskRuntime 'node-compile-cache'
+$env:APPDATA = Join-Path $taskRuntime 'appdata'
+$env:LOCALAPPDATA = Join-Path $taskRuntime 'localappdata'
+$env:ELECTRON_RUN_AS_NODE = '1'
+$env:DSH_DESKTOP_NODE_EXECUTABLE = 'D:\deepseek harness\DeepSeek Harness.exe'
+foreach ($taskName in @('temp','agents','cache','node-compile-cache','appdata','localappdata','logs')) {
+    New-Item -ItemType Directory -Path (Join-Path $taskRuntime $taskName) -Force | Out-Null
+}
+$taskProcess = Start-Process -FilePath $env:DSH_DESKTOP_NODE_EXECUTABLE -ArgumentList @('--expose-internals',
+    '"D:\deepseek harness\resources\app.asar\dsh\node_modules\@deepseek-ai\dsh-desktop-host\lib\cli.js"',
+    '--profile', 'companion', '--host', '127.0.0.1', '--port', $taskPort, '--no-open') -WindowStyle Hidden `
+    -WorkingDirectory 'D:\dafeiyu\qq-bridge' -RedirectStandardOutput (Join-Path $taskRuntime 'logs\dsh.stdout.log') `
+    -RedirectStandardError (Join-Path $taskRuntime 'logs\dsh.stderr.log') -PassThru
+for ($taskAttempt=0; $taskAttempt -lt 60; $taskAttempt++) {
+    if (Get-NetTCPConnection -LocalPort $taskPort -State Listen -ErrorAction SilentlyContinue) {
+        [ordered]@{ status='ready'; pid=$taskProcess.Id; port=$taskPort; home=$taskHome } |
+            ConvertTo-Json -Compress | Tee-Object -FilePath (Join-Path $taskRuntime 'dsh.runtime.json')
+        return
+    }
+    if ($taskProcess.HasExited) { throw 'DSH exited. Inspect D:\dafeiyu\runtime-data\logs\dsh.stderr.log' }
+    Start-Sleep -Milliseconds 500
+}
+throw 'DSH did not become ready on 127.0.0.1:8784.'
