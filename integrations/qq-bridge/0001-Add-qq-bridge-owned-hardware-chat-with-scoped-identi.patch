@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import { fileURLToPath } from 'node:url';
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'qq-hardware-mcp-'));
+const tokenFile = path.join(temporary, 'token'); fs.writeFileSync(tokenFile, 'fixture-token');
+const configFile = path.join(temporary, 'config.json');
+let calls = [];
+const api = http.createServer(async (request, response) => {
+  assert.equal(request.headers.authorization, 'Bearer fixture-token');
+  let raw = ''; for await (const chunk of request) raw += chunk;
+  const body = JSON.parse(raw); calls.push({ endpoint: request.url, body });
+  const allowed = body.turn_token === 'a'.repeat(43);
+  response.writeHead(allowed ? 200 : 403, { 'content-type': 'application/json' });
+  response.end(JSON.stringify(allowed ? { state: 'accepted', playback_confirmed: false } : { error: 'STALE_CAPABILITY' }));
+});
+await new Promise(resolve => api.listen(0, '127.0.0.1', resolve));
+fs.writeFileSync(configFile, JSON.stringify({ port: api.address().port, gatewayTokenFile: tokenFile }));
+const client = new Client({ name: 'qq-hardware-contract', version: '1' });
+try {
+  await client.connect(new StdioClientTransport({ command: process.execPath, args: [path.join(root, 'src', 'mcp-companion-hardware.js')],
+    cwd: root, stderr: 'pipe', env: { ...process.env, QQ_HARDWARE_CONFIG: configFile } }));
+  assert.deepEqual((await client.listTools()).tools.map(tool => tool.name).sort(), ['hardware_memory', 'hardware_reply', 'hardware_status']);
+  const scope = { turn_id: 'hw-' + 'b'.repeat(32), turn_token: 'a'.repeat(43) };
+  const accepted = await client.callTool({ name: 'hardware_reply', arguments: { ...scope, text: '你好', emotion: 'HAPPY' } });
+  assert.equal(JSON.parse(accepted.content[0].text).playback_confirmed, false);
+  assert.equal(calls[0].endpoint, '/v1/hardware/reply');
+  assert.equal(calls[0].body.text, '你好');
+  assert.equal('device_id' in calls[0].body, false);
+  assert.equal('user_id' in calls[0].body, false);
+  const denied = await client.callTool({ name: 'hardware_reply', arguments: { ...scope, turn_token: 'x'.repeat(43), text: '旧回复' } });
+  assert.equal(denied.isError, true);
+  fs.writeFileSync(configFile, JSON.stringify({ port: '8781@external.invalid', gatewayTokenFile: tokenFile }));
+  const count = calls.length;
+  const malformed = await client.callTool({ name: 'hardware_status', arguments: scope });
+  assert.equal(malformed.isError, true);
+  assert.equal(calls.length, count);
+  console.log('PASS hardware MCP: real stdio handshake, scoped reply, no selectable identity/device, stale capability and local-port rejection');
+} finally {
+  await client.close();
+  await new Promise(resolve => api.close(resolve));
+  if (path.dirname(temporary) !== os.tmpdir() || !path.basename(temporary).startsWith('qq-hardware-mcp-')) throw new Error('Unexpected fixture directory');
+  fs.rmSync(temporary, { recursive: true });
+}
