+    return this.snapshot(row.id);
+  }
+  assertLive(id, token) {
+    const row = this.store.get(id);
+    const live = this.live.get(id);
+    if (!row || !live || live.cancelled || TERMINAL.has(row.state) || !equal(live.token, token)
+        || this.activeByDevice.get(this.deviceId) !== id) throw fail('STALE_OR_INVALID_HARDWARE_CAPABILITY', 403);
+    return { row, live };
+  }
