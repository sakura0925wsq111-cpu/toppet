+// Tools for qq-bridge-managed hardware turns, never generic/QQ remote control.
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
+import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
+import { z } from 'zod';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const server = new McpServer({ name: 'companion-hardware', version: '0.1.0' });
+const scope = { turn_id: z.string().regex(/^hw-[a-f0-9]{32}$/), turn_token: z.string().min(32).max(64) };
+function register(name, description, schema, endpoint) {
+  server.tool(name, description, schema, async args => {
+    try {
+      const config = JSON.parse(fs.readFileSync(process.env.QQ_HARDWARE_CONFIG || path.join(root, 'hardware.channel.local.json'), 'utf8'));
+      if (!Number.isInteger(config.port) || config.port < 1 || config.port > 65535) throw new Error('invalid local gateway port');
+      const token = fs.readFileSync(config.gatewayTokenFile, 'utf8').trim();
+      const response = await fetch(`http://127.0.0.1:${config.port}${endpoint}`, {
+        method: 'POST', headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
+        body: JSON.stringify(args), redirect: 'error', signal: AbortSignal.timeout(12000),
+      });
+      const value = await response.json();
+      return { ...(response.ok ? {} : { isError: true }), content: [{ type: 'text', text: JSON.stringify(value) }] };
+    } catch {
+      return { isError: true, content: [{ type: 'text', text: 'qq-bridge hardware channel unavailable; no output is confirmed.' }] };
+    }
+  });
+}
+register('hardware_reply', '回答当前真实硬件用户。绑定用户、设备和录音会话由qq-bridge确定，不能指定其他设备或发QQ。每轮仅一次回复；相同调用重试不会重播。accepted不等于已播完。', {
+  ...scope, text: z.string().trim().min(1).max(120),
+  emotion: z.enum(['NEUTRAL', 'HAPPY', 'HEART', 'SHY', 'SAD', 'ANGRY', 'SURPRISED', 'SLEEPY',
+    'WORKING', 'GREETING', 'CELEBRATE', 'READING', 'EATING', 'DRINKING', 'COOL']).default('NEUTRAL'),
+}, '/v1/hardware/reply');
+register('hardware_status', '查询本轮硬件回复结果；只有playback_confirmed=true才表示设备报告完整播放。不能据此声称用户听到了。', scope, '/v1/hardware/status');
+register('hardware_memory', '沿用qq-bridge的该用户长期记忆。read只读；write/forget必须引用本轮用户讲话中的直接依据，不得写其他人信息或推测。', {
+  ...scope, operation: z.enum(['read', 'write', 'forget']), text: z.string().max(220).optional(),
+  evidence: z.string().max(1600).optional(),
+}, '/v1/hardware/memory');
+await server.connect(new StdioServerTransport());
